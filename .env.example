# Optional. Leave empty to use the embedded demo database (PGlite, data resets on cold start).
# Postgres connection string. On Supabase use the pooler URI (Project Settings → Database →
# Connection string → "Transaction pooler", port 6543) and append ?sslmode=require.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Max connections per server instance. Use 1–2 on Vercel (each function instance has its own pool).
DB_POOL_MAX=2

# Random string, at least 32 characters. Signs session cookies. Optional for the demo (built-in fallback). Generate: openssl rand -base64 48
SESSION_SECRET=

# AI analyst: set ONE of these (server-only). Without any, the analyst shows a clear "AI unavailable" state.
# GROQ_API_KEY (console.groq.com/keys) gives the fastest replies and has a free tier.
# GEMINI_API_KEY also has a free tier: create it at aistudio.google.com.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: force a provider when several keys are set (groq | gemini | openai | anthropic), or pick a model.
# Defaults: llama-3.3-70b-versatile, gemini-flash-latest, gpt-5-mini, claude-sonnet-5-5.
# If the main model is overloaded (503) or rate-limited, the app retries, then uses a lighter model
# (Gemini: gemini-flash-lite-latest, Groq: llama-3.1-8b-instant). AI_FALLBACK_MODEL overrides; "none" disables.
# AI_REASONING sets how much Gemini/OpenAI "think" per step (default low; none|minimal|low|medium|high).
AI_PROVIDER=
AI_MODEL=
# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Public URL of the deployment (used in docs/links only).
APP_BASE_URL=https://your-app.vercel.app

# Set to "false" to hide the demo accounts box on the login page.
# Set to true to list the demo accounts under the sign-in form. Hidden by default.
SHOW_DEMO_LOGINS=false

# Enables the one-time /setup page (16+ characters). Remove it after setup.
SETUP_TOKEN=

# With a real DATABASE_URL, an empty database is set up automatically on first use (tables + demo data).
# Set to false to manage migrations and seeding yourself.
AUTO_SETUP=true
